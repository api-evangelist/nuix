        {
          "name": "collections",
          "item": [
            {
              "name": "Lists all collections for the specified case",
              "id": "7df395ce-f01e-4cfa-b5c8-33e675013628",
              "protocolProfileBehavior": {
                "disableBodyPruning": true
              },
              "request": {
                "method": "GET",
                "header": [
                  {
                    "key": "Accept",
                    "value": "application/json"
                  }
                ],
                "url": {
                  "raw": "{{baseUrl}}/v2/collections?caseId=<string>",
                  "host": [
                    "{{baseUrl}}"
                  ],
                  "path": [
                    "v2",
                    "collections"
                  ],
                  "query": [
                    {
                      "description": "(Required) Case identification token of the case to list collections",
                      "key": "caseId",
                      "value": "<string>"
                    }
                  ]
                },
                "description": "Lists all collections for the specified case.\n\nNote that completed and failed collections are listed as well as currently running collections"
              },
