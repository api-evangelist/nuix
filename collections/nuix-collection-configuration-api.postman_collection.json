          "name": "Delete the Configuration",
          "request": {
            "name": "Delete the Configuration",
            "description": {
              "content": "Delete the configuration identified by `{id}`",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "v2",
                "configurations",
                ":id"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
