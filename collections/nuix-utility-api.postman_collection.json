        {
          "name": "eccInstalled",
          "item": [
            {
              "name": "Verify whether ECC Client or ECC Admin Console is installed on the specified\u2026",
              "id": "3a4b6ed3-afee-4f83-aa11-888447e6540f",
              "protocolProfileBehavior": {
                "disableBodyPruning": true
              },
              "request": {
                "method": "GET",
                "header": [
                  {
                    "key": "Accept",
                    "value": "application/json"
                  }
                ],
                "url": {
                  "raw": "{{baseUrl}}/v2/eccInstalled?computerId=<string>",
                  "host": [
                    "{{baseUrl}}"
                  ],
                  "path": [
                    "v2",
                    "eccInstalled"
                  ],
                  "query": [
                    {
                      "description": "(Required) GUID which identifies the computer",
                      "key": "computerId",
                      "value": "<string>"
                    }
                  ]
                },
                "description": "Verify whether ECC Client or ECC Admin Console is installed on the specified computer.\nIf ECC Client or ECC Admin Console is installed, returns the name of the specified computer.\nIf ECC client or ECC Admin Console is not installed, returns an ID 400 response."
              },
              "response": [
                {
                  "id": "71383121-6f6e-4f99-ab1c-df3ccc74739d",
                  "name": "Successful query of ECC Installed",
                  "originalRequest": {
                    "method": "GET",
