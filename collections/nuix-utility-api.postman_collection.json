        {
          "id": "f796d406-c390-4200-898d-4c8d0d42ae97",
          "name": "Verify whether ECC Client or ECC Admin Console is installed on the specified computer.",
          "request": {
            "name": "Verify whether ECC Client or ECC Admin Console is installed on the specified computer.",
            "description": {
              "content": "Verify whether ECC Client or ECC Admin Console is installed on the specified computer.\nIf ECC Client or ECC Admin Console is installed, returns the name of the specified computer.\nIf ECC client or ECC Admin Console is not installed, returns an ID 400 response.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "v2",
                "eccInstalled"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "computerId",
                  "value": "<string>",
                  "description": "(Required) GUID which identifies the computer"
                }
              ],
              "variable": [
                {
                  "description": "protocol for communication (This can only be one of http,https)",
                  "type": "any",
                  "value": "{{protocol}}",
                  "key": "protocol"
                },
                {
                  "description": "The location which the ECC resides",
                  "type": "any",
                  "value": "{{address}}",
                  "key": "address"
                },
                {
                  "description": "80, 443 or alternative",
                  "type": "any",
                  "value": "{{port}}",
                  "key": "port"
                }
              ]
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
            "auth": null
          },
