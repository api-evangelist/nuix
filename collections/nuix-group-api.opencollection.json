{
  "opencollection": "1.0.0",
  "info": {
    "name": "NUIX ECC REST API Command Reference Case Group API",
    "version": "${customer.version}"
  },
  "request": {
    "auth": {
      "type": "basic",
      "username": "{{username}}",
      "password": "{{password}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Group",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Lists all Groups",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "{protocol}://{address}:{port}/api/ecc/v2/groups"
          },
          "docs": "Lists all custodian groups defined on the connected server."
        },
        {
          "info": {
            "name": "Create a new group",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "{protocol}://{address}:{port}/api/ecc/v2/group",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Create a new group."
        },
        {
          "info": {
            "name": "Modify a group",
            "type": "http"
          },
          "http": {
            "method": "PUT",
            "url": "{protocol}://{address}:{port}/api/ecc/v2/group",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Modifies or renames a new group."
        },
        {
          "info": {
            "name": "Delete a group",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "{protocol}://{address}:{port}/api/ecc/v2/group",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Delete a group specified by groupId in the request body.\n\n**Note\\:** once a group is deleted any custodians which (1) previously belonged to the deleted\ngroup, and (2) which do not belong to another group will be added to the \"unassigned\" group."
        }
      ]
    }
  ],
  "bundled": true
}