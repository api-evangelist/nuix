                    "value": "application/json"
                  }
                ],
                "method": "POST",
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"limit\": -1,\n  \"sortBy\": \"Name\",\n  \"filters\": [\n    {\n      \"name\": \"Presence\",\n      \"value\": \"Online\"\n    },\n    {\n      \"name\": \"Purpose\",\n      \"value\": \"Client\"\n    }\n  ]\n}",
                  "options": {
                    "raw": {
                      "language": "json"
                    }
                  }
                }
              },
              "status": "OK",
              "code": 200,
              "header": [
                {
                  "key": "Content-Type",
                  "value": "application/json"
                }
              ],
              "body": "{\n  \"tableVersion\": 6111,\n  \"totalCount\": 5182,\n  \"startRow\": 1644,\n  \"endRow\": 6046,\n  \"next\": \"string\",\n  \"computers\": [\n    {\n      \"name\": \"string\",\n      \"fullName\": \"string\",\n      \"description\": \"string\",\n      \"UUID\": \"string\",\n      \"presence\": \"NEARLINE\",\n      \"purpose\": \"Client\",\n      \"staging\": true,\n      \"pairingState\": \"Awaiting\",\n      \"firstContact\": \"string\",\n      \"lastContact\": \"string\",\n      \"osName\": \"string\",\n      \"lastUser\": \"string\",\n      \"searchEnabled\": true\n    },\n    {\n      \"name\": \"string\",\n      \"fullName\": \"string\",\n      \"description\": \"string\",\n      \"UUID\": \"string\",\n      \"presence\": \"NEARLINE\",\n      \"purpose\": \"Client\",\n      \"staging\": false,\n      \"pairingState\": \"Awaiting\",\n      \"firstContact\": \"string\",\n      \"lastContact\": \"string\",\n      \"osName\": \"string\",\n      \"lastUser\": \"string\",\n      \"searchEnabled\": true\n    }\n  ]\n}",
