      "item": [
        {
          "id": "ee3dd4bd-9b02-46e0-b4df-baae36c819b3",
          "name": "Lists computers (endpoints) with ECC installed",
          "request": {
            "name": "Lists computers (endpoints) with ECC installed",
            "description": {
              "content": "Lists computers (endpoints) with ECC Client or ECC Admin Console installed.\nIf the `computerId` field in the JSON body is provided, all other fields are ignored, as only that single computer will be returned.  Otherwise a list of computers will be returned matching the criteria provided in the `filters` section.\n\nComputer Fields available for filters and sorting\\:\n\n| Field name       | Type    | Description / Possible Values   |\n| ---------------- | ------- | ------------------------------- |\n| ID               | long    | id of computer                  |\n| Name             | String  | name of the computer            |\n| Description      | String  | computer description (may be null)                             |\n| ConfigId         | String  | id of the Computer Configuration associated with this computer |\n| Purpose          | String  | `Client` or `Admin Console`     |\n| Presence         | String  | `Online`, `Nearline` or `Offline` - see note, below            |\n| PairingState     | String  | `Paired`, `Awaiting` or `Denied`  |\n| Staging          | Boolean | `true` if the computer is a staging computer                   |\n| TimeZoneID       | String  |                                 |\n| TimeZoneOffset   | String  |                                 |\n| FirstContactTime | String  | date/time of first contact in the format `yyyy-mm-ddThh:mm:ss` |\n| LastContactTime  | String  | date/time of last contact in the format `yyyy-mm-ddThh:mm:ss`  |\n| UUID             | String  | GUID uniquely identifying this computer                        |\n| OSName           | String  | name of the OS                  |\n| SearchEnabled    | Boolean | `true` specifies  Advanced Search is enabled on this computer  |\n| ClientParameters | String  |                                 |\n| ClientPublicKey  | String  |                                 |\n| Config           | long    |                                 |\n| ConfigName       | String  |                                 |\n| FullName         | String  | name of the computer including domain                          |\n| History          | String  |                                 |\n| LastUser         | String  | last logged in username         |\n| OSName           | String  | name of the OS                  |\n| PeerIP           | String  |                                 |\n| ServerParameters | String  |                                 |\n| ServerPrivateKey | String  |                                 |\n| ServerPublicKey  | String  |                                 |\n**Note\\:** Presence values are case-sensitive: they must be `Nearline`, `Online` or `Offline` in a request body. Values returned for Presence however, are returned in ALL UPPERCASE.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "v2",
                "computers"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "offset",
                  "value": "<integer>",
                  "description": "offset (0-based) into the list of computers at which retrieval should start"
                },
                {
                  "disabled": false,
                  "key": "version",
                  "value": "<integer>",
                  "description": "version of the Jobs table from the last call to this function.\n\nThe version of the table is returned in the response body for this query in the field `tableVersion`.\n\nIf `version` is supplied, it is compared to the current version of the Jobs table.\n\nIf the version numbers match, there is no updated data since the last call, \nand the query is aborted with a 204, 'No Content.' response code."
                },
                {
                  "disabled": false,
                  "key": "countOnly",
                  "value": "<boolean>",
                  "description": "if `true`, the total count for this query (ignoring `limit` and `offset`) is returned in the Response Body, with no other data.\n\nThis should be used ahead of the actual query to determine the total number of records in the response."
                }
              ],
              "variable": [
                {
                  "description": "protocol for communication (This can only be one of http,https)",
                  "type": "any",
                  "value": "{{protocol}}",
                  "key": "protocol"
                },
                {
                  "description": "The location which the ECC resides",
                  "type": "any",
                  "value": "{{address}}",
                  "key": "address"
                },
                {
                  "description": "80, 443 or alternative",
                  "type": "any",
                  "value": "{{port}}",
                  "key": "port"
                }
              ]
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "POST",
            "auth": null,
            "body": {
              "mode": "raw",
              "raw": "{\n  \"limit\": \"<integer>\",\n  \"computerId\": \"<string>\",\n  \"sortBy\": \"<string>\",\n  \"ascending\": \"<boolean>\",\n  \"where\": \"<string>\",\n  \"filters\": [\n    {\n      \"name\": \"<string>\",\n      \"value\": {}\n    },\n    {\n      \"name\": \"<string>\",\n      \"value\": {}\n    }\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [
            {
              "id": "afdffcbe-64f7-446c-9cc6-e9ca670261d8",
              "name": "Computer Listing was submitted successfully",
