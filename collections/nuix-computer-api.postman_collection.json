                      "type": "any",
                      "value": "{{protocol}}",
                      "key": "protocol"
                    },
                    {
                      "description": "The location which the ECC resides",
                      "type": "any",
                      "value": "{{address}}",
                      "key": "address"
                    },
                    {
                      "description": "80, 443 or alternative",
                      "type": "any",
                      "value": "{{port}}",
                      "key": "port"
                    }
                  ]
