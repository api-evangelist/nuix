                    "key": "Accept",
                    "value": "application/json"
                  }
                ],
                "url": {
                  "raw": "{{baseUrl}}/v2/logs?jobId=<integer>",
                  "host": [
                    "{{baseUrl}}"
                  ],
                  "path": [
                    "v2",
                    "logs"
                  ],
                  "query": [
                    {
                      "description": "(Required) ID of the job for which log information should be displayed",
